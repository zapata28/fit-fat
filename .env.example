# URL de tu proyecto Supabase (Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Secret key de Supabase (Settings > API Keys > Secret keys) - reemplaza al viejo service_role
# NUNCA la expongas en el cliente, solo se usa en las funciones /api.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# Cualquier cadena larga y aleatoria, usada para firmar las sesiones.
AUTH_SECRET=cambia-esto-por-algo-aleatorio-y-largo
